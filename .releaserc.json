{
  "branches": ["main"],
  "tagFormat": "v${version}",
  "plugins": [
    ["@semantic-release/commit-analyzer", { "preset": "conventionalcommits" }],
    ["@semantic-release/release-notes-generator", { "preset": "conventionalcommits" }],
    ["@semantic-release/changelog", { "changelogFile": "CHANGELOG.md" }],
    ["@semantic-release/exec", {
      "prepareCmd": "npm version ${nextRelease.version} --no-git-tag-version --allow-same-version && node scripts/sync-server-json-version.mjs",
      "publishCmd": "pnpm publish --access public --no-git-checks --provenance"
    }],
    ["@semantic-release/git", {
      "assets": ["CHANGELOG.md", "package.json", "server.json"],
      "message": "chore(release): v${nextRelease.version} [skip ci]"
    }],
    ["@semantic-release/github", { "successComment": false, "failCommentCondition": false }]
  ]
}
