exports[`golden render > renders stable SVG for sample "temperature-anomaly" 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" width="800" height="500" viewBox="0 0 800 500" role="img" aria-label="2024 was the hottest year on record" font-family="sans-serif" color="#333333"><title>2024 was the hottest year on record</title><desc>Deviation from the 1951–1980 average, in °C line chart of 10 categories, values from 0.12 to 1.28.</desc><rect width="100%" height="100%" fill="#ffffff"></rect><text x="16" y="36" font-size="20px" font-weight="bold" fill="#333333">2024 was the hottest year on record</text><text x="16" y="59" font-size="14px" fill="#333333">Deviation from the 1951–1980 average, in °C</text><text x="16" y="481" font-size="12px" fill="#333333">Source: NASA GISS</text><text x="784" y="481" font-size="12px" font-weight="600" text-anchor="end" fill="#333333">Blueprint Chart</text><g transform="translate(16,62.5)"><svg xmlns="http://www.w3.org/2000/svg" width="768" height="398.5" style="overflow: visible;" role="img" aria-label="line chart"><title>line chart</title><desc>line chart of 10 categories, values from 0.12 to 1.28.</desc><g transform="translate(27,12)"><g class="bc-annotations-range"></g><g class="bc-axis-service-v"><g><g class="bc-axis bc-axis-vertical" fill="none" font-size="10" font-family="sans-serif" text-anchor="end"><g class="tick" opacity="1" transform="translate(0,363)"><text fill="currentColor" x="-9" dy="0.32em">0.1</text><line class="bc-grid-line" x1="0" x2="726" y1="0" y2="0" stroke="#ccc" stroke-width="1" stroke-dasharray="4,4"></line></g><g class="tick" opacity="1" transform="translate(0,332.79166666666663)"><text fill="currentColor" x="-9" dy="0.32em">0.2</text><line class="bc-grid-line" x1="0" x2="726" y1="0" y2="0" stroke="#ccc" stroke-width="1" stroke-dasharray="4,4"></line></g><g class="tick" opacity="1" transform="translate(0,302.58333333333337)"><text fill="currentColor" x="-9" dy="0.32em">0.3</text><line class="bc-grid-line" x1="0" x2