exports[`golden render > renders stable SVG for sample "population-stacked-bar" 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" width="800" height="500" viewBox="0 0 800 500" role="img" aria-label="India has far more children than China, and a workforce nearly as large" font-family="sans-serif" color="#333333"><title>India has far more children than China, and a workforce nearly as large</title><desc>Millions of people, 2023 bar stacked chart of 5 categories across 3 series (0-14, 15-64, 65+), values from 21 to 988.</desc><rect width="100%" height="100%" fill="#ffffff"></rect><text x="16" y="36" font-size="20px" font-weight="bold" fill="#333333">India has far more children than China, and a workforce nearly</text><text x="16" y="61" font-size="20px" font-weight="bold" fill="#333333">as large</text><text x="16" y="84" font-size="14px" fill="#333333">Millions of people, 2023</text><text x="16" y="481" font-size="12px" fill="#333333">Source: UN Population Division</text><text x="784" y="481" font-size="12px" font-weight="600" text-anchor="end" fill="#333333">Blueprint Chart</text><g transform="translate(16,87.5)"><svg xmlns="http://www.w3.org/2000/svg" width="768" height="373.5" role="img" aria-label="bar stacked chart"><title>bar stacked chart</title><desc>bar stacked chart of 5 categories across 3 series (0-14, 15-64, 65+), values from 21 to 988.</desc><g transform="translate(60,35)"><g class="bc-axis-service-h"><g><g class="bc-axis bc-axis-horizontal" transform="translate(0,333.5)" fill="none" font-size="10" font-family="sans-serif" text-anchor="middle"><g class="tick" opacity="1" transform="translate(0.5,0)"></g><g class="tick" opacity="1" transform="translate(89,0)"></g><g class="tick" opacity="1" transform="translate(177.5,0)"></g><g class="tick" opacity="1" transform="translate(266,0)"></g><g class="tick" opacity="1" transform="translate(354.5,0)"></g><g class="tick" opacity="1" transform="translate(443,0)"></g><g class="tick" opacity="1" transform="translate(53