a-bc-role="mark-per-category" data-bc-key="India" x="280.52941176470586" y="277.1730769230769" width="73.82352941176471" height="85.3269230769231" fill="#2563A0" opacity="0.35"></rect><rect class="bc-bar" data-bc-role="mark-per-category" data-bc-key="Russia" x="398.6470588235294" y="314.25961538461536" width="73.82352941176471" height="48.24038461538464" fill="#2563A0" opacity="0.35"></rect><rect class="bc-bar" data-bc-role="mark-per-category" data-bc-key="Japan" x="516.7647058823529" y="334.8942307692308" width="73.82352941176471" height="27.605769230769226" fill="#2563A0" opacity="0.35"></rect><rect class="bc-bar" data-bc-role="mark-per-category" data-bc-key="Germany" x="634.8823529411765" y="346.0480769230769" width="73.82352941176471" height="16.451923076923094" fill="#2563A0" opacity="0.35"></rect></g></g><g><g class="bc-value-label-group"><text class="bc-value-label" font-size="11px" data-bc-role="value-label" data-bc-key="China" x="81.20588235294113" y="19.144230769230784" text-anchor="middle" dominant-baseline="auto" fill="currentColor">12.17</text><text class="bc-value-label" font-size="11px" data-bc-role="value-label" data-bc-key="United States" x="199.32352941176467" y="221.30769230769232" text-anchor="middle" dominant-baseline="auto" fill="currentColor">4.92</text><text class="bc-value-label" font-size="11px" data-bc-role="value-label" data-bc-key="India" x="317.44117647058823" y="273.1730769230769" text-anchor="middle" dominant-baseline="auto" fill="currentColor">3.06</text><text class="bc-value-label" font-size="11px" data-bc-role="value-label" data-bc-key="Russia" x="435.55882352941177" y="310.25961538461536" text-anchor="middle" dominant-baseline="auto" fill="currentColor">1.73</text><text class="bc-value-label" font-size="11px" data-bc-role="value-label" data-bc-key="Japan" x="553.6764705882352" y="330.8942307692308" text-anchor="middle" dominant-baseline="auto" fill="currentColor">0.99</text><text class="bc-value-label" font-size="11px" data-bc-rol