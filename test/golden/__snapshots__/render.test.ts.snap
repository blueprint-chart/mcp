exports[`golden render > renders stable SVG for sample "browser-market" 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" width="800" height="500" viewBox="0 0 800 500" role="img" aria-label="The top 1% hold 38% of all global wealth" font-family="sans-serif" color="#333333"><title>The top 1% hold 38% of all global wealth</title><desc>Share of global wealth by group, 2021 donut chart of 4 categories, values from 2 to 38.</desc><rect width="100%" height="100%" fill="#ffffff"></rect><text x="16" y="36" font-size="20px" font-weight="bold" fill="#333333">The top 1% hold 38% of all global wealth</text><text x="16" y="59" font-size="14px" fill="#333333">Share of global wealth by group, 2021</text><text x="16" y="481" font-size="12px" fill="#333333">Source: World Inequality Report 2022</text><text x="784" y="481" font-size="12px" font-weight="600" text-anchor="end" fill="#333333">Blueprint Chart</text><g transform="translate(16,62.5)"><svg xmlns="http://www.w3.org/2000/svg" width="768" height="398.5" role="img" aria-label="donut chart"><title>donut chart</title><desc>donut chart of 4 categories, values from 2 to 38.</desc><g transform="translate(148.5,30)"><g transform="translate(235.5,169.25)"><g><path class="bc-arc" data-bc-role="mark-per-category" data-bc-key="Top 1%" data-series="Top 1%" d="M0,-169.25A169.25,169.25,0,0,1,115.86,123.378L69.516,74.027A101.55,101.55,0,0,0,0,-101.55Z" fill="#302e62" opacity="1"></path><path class="bc-arc" data-bc-role="mark-per-category" data-bc-key="Next 9%" data-series="Next 9%" d="M115.86,123.378A169.25,169.25,0,0,1,-168.916,-10.627L-101.35,-6.376A101.55,101.55,0,0,0,69.516,74.027Z" fill="#0527b4" opacity="0.35"></path><path class="bc-arc" data-bc-role="mark-per-category" data-bc-key="Middle 40%" data-series="Middle 40%" d="M-168.916,-10.627A169.25,169.25,0,0,1,-21.213,-167.915L-12.728,-100.749A101.55,101.55,0,0,0,-101.35,-6.376Z" fill="#555dfe" opacity="0.35"></path><path class="bc-arc" data-bc-role="mark-per-category" data-bc-key="Bottom 50%" data-series="Bottom 50%" d="M-21.213,-167.915A169.25,169.25,0,0,1,0,-169.25L0,-101.55A101.55,101.55,0,0,0,-12.728,-100.749Z" fill="#e4e500" opacity="0.35"></path></g><g class="bc-arc-labels-inside"><text class="bc-arc-inside-label" x="125.89173618926925" y="-49.84406443350538" text-anchor="middle" dominant-baseline="central" font-size="12px"><tspan x="125.89173618926925" dy="-0.5em" font-weight="bold" fill="#fff">Top 1%</tspan><tspan x="125.89173618926925" dy="1.2em" fill="#fff" opacity="0.85">38%</tspan></text><text class="bc-arc-inside-label" x="-57.65051607791085" y="122.51358290389904" text-anchor="middle" dominant-baseline="central" font-size="12px"><tspan x="-57.65051607791085" dy="-0.5em" font-weight="bold" fill="#fff">Next 9%</tspan><tspan x="-57.65051607791085" dy="1.2em" fill="#fff" opacity="0.85">38%</tspan></text><text class="bc-arc-inside-label" x="-98.70235215285904" y="-92.68767814274455" text-anchor="middle" dominant-baseline="central" font-size="12px"><tspan x="-98.70235215285904" dy="-0.5em" font-weight="bold" fill="#fff">Middle 40%</tspan><tspan x="-98.70235215285904" dy="1.2em" fill="#fff" opacity="0.85">22%</tspan></text></g><g class="bc-arc-labels"><polyline class="bc-arc-label-line" points="-10.752876469394886,-170.9120772433415 -11.883105820922525,-188.8765583550504 -31.883105820922523,-188.8765583550504" fill="none" stroke="var(--bc-text-color, #999)" stroke-width="1" opacity="0.5"></polyline><text class="bc-arc-direct-label" x="-35.88310582092252" y="-188.8765583550504" text-anchor="end" font-size="12px"><tspan x="-35.88310582092252" dy="-0.1em" font-weight="bold" fill="#687200">Bottom 50%</tspan><tspan x="-35.88310582092252" dy="1.2em" fill="var(--bc-text-color, #666)">2%</tspan></text></g></g></g></svg></g></svg>"`;

exports[`golden render > renders stable SVG for sample "co2-emissions" 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" width="800" height="500" viewBox="0 0 800 500" role="img" aria-label="China emits more CO₂ than the US and India combined" font-family="sans-serif" color="#333333"><title>China emits more CO₂ than the US and India combined</title><desc>Annual emissions in billion tonnes, 2023 bar vertical chart of 6 categories, values from 0.59 to 12.17.</desc><rect width="100%" height="100%" fill="#ffffff"></rect><text x="16" y="36" font-size="20px" font-weight="bold" fill="#333333">China emits more CO₂ than the US and India combined</text><text x="16" y="59" font-size="14px" fill="#333333">Annual emissions in billion tonnes, 2023</text><text x="16" y="481" font-size="12px" fill="#333333">Source: Our World in Data</text><text x="784" y="481" font-size="12px" font-weight="600" text-anchor="end" fill="#333333">Blueprint Chart</text><g transform="translate(16,62.5)"><svg xmlns="http://www.w3.org/2000/svg" width="768" height="398.5" style="overflow: visible;" role="img" aria-label="bar vertical chart"><title>bar vertical chart</title><desc>bar vertical chart of 6 categories, values from 0.59 to 12.17.</desc><g transform="translate(0,12)"><g class="bc-annotations-range"></g><g class="bc-axis-service-v"><g><g class="bc-axis bc-axis-vertical" fill="none" font-size="10" font-family="sans-serif" text-anchor="end"><g class="tick" opacity="1" transform="translate(0,363)"></g><g class="tick" opacity="1" transform="translate(0,335.11538461538464)"></g><g class="tick" opacity="1" transform="translate(0,307.2307692307692)"></g><g class="tick" opacity="1" transform="translate(0,279.3461538461538)"></g><g class="tick" opacity="1" transform="translate(0,251.46153846153845)"></g><g class="tick" opacity="1" transform="translate(0,223.5769230769231)"></g><g class="tick" opacity="1" transform="translate(0,195.69230769230768)"></g><g class="tick" opacity="1" transform="translate(0,167.80